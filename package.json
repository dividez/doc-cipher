{
  "name": "doccipher",
  "productName": "DocCipher",
  "description": "Offline Electron client for reversible Word docx desensitization",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.1.2",
  "author": "DocCipher",
  "main": "packages/entry-point.mjs",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=23.0.0"
  },
  "scripts": {
    "dev": "node packages/dev-mode.js",
    "build": "pnpm -r --if-present build",
    "compile": "pnpm run build && electron-builder build --config electron-builder.mjs",
    "test": "npx playwright test ./tests/e2e.spec.ts",
    "start": "node packages/dev-mode.js",
    "typecheck": "pnpm -r --if-present typecheck",
    "create-renderer": "cd packages && node ./integrate-renderer/create-renderer.js",
    "integrate-renderer": "npm start --workspace @app/integrate-renderer",
    "init": "npm run create-renderer && npm run integrate-renderer && npm install"
  },
  "devDependencies": {
    "@npmcli/map-workspaces": "5.0.3",
    "@playwright/test": "1.60.0",
    "@types/node": "25.8.0",
    "create-vite": "9.0.7",
    "electron": "42.1.0",
    "electron-builder": "26.8.1",
    "glob": "13.0.6",
    "playwright": "1.60.0",
    "vite": "8.0.13"
  },
  "dependencies": {
    "@app/main": "workspace:*",
    "@app/preload": "workspace:*",
    "@app/renderer": "workspace:*"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "electron-winstaller"
    ]
  }
}
